# Copy to .env and replace every CHANGE_ME value before non-development use.
POSTGRES_DB=m365ops
POSTGRES_USER=m365ops
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
RABBITMQ_USER=m365ops
RABBITMQ_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_VALUE
APP_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY
JWT_ISSUER=https://login.microsoftonline.com/organizations/v2.0
JWT_AUDIENCE=api://m365-intelligence-platform
OLLAMA_MODEL=phi4-mini
# Generate these values with `cd apps/web && npm run auth:setup`.
AEGIS_LOCAL_USERS_B64=CHANGE_ME
AEGIS_SESSION_SECRET=CHANGE_ME_AT_LEAST_43_RANDOM_CHARACTERS
AEGIS_INTERNAL_API_SECRET=CHANGE_ME_AT_LEAST_43_RANDOM_CHARACTERS
AEGIS_COOKIE_SECURE=true

# Reserved Microsoft 365 collector configuration. Keep disabled until the
# production Graph collector and its release gates are implemented.
M365_GRAPH_ENABLED=false
M365_TENANT_ID=CHANGE_ME_DIRECTORY_TENANT_ID
M365_CLIENT_ID=CHANGE_ME_APPLICATION_CLIENT_ID
M365_CLOUD=global
M365_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
M365_CERTIFICATE_THUMBPRINT=CHANGE_ME_CERTIFICATE_THUMBPRINT
M365_CERTIFICATE_PATH=/run/secrets/m365-collector.pem
